MONITOR_IMAGE=ghcr.io/thekiharani/monitor:latest
MONITOR_SMART_IMAGE=ghcr.io/thekiharani/monitor-smart:latest
MONITOR_BIND=127.0.0.1
MONITOR_PORT=9100
APP_NETWORK=norialabs

MONITOR_PASSWORD=

POSTGRES_URL=postgres://monitor:change-me@postgres:5432/postgres?sslmode=disable
REDIS_URL=redis://:change-me@redis:6379

COMPOSE_PROFILES=smart
SMART_INTERVAL=15m
