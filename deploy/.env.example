IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=monitor
MONITOR_BIND=127.0.0.1
MONITOR_PORT=9100

MONITOR_PASSWORD=

# Space-separated URLs; prefix one with name= to label its card.
POSTGRES_URL=
MYSQL_URL=
MONGODB_URL=
REDIS_URL=
MEMCACHED_URL=
NGINX_URL=
CADDY_URL=
TRAEFIK_URL=
HAPROXY_URL=
APACHE_URL=
RABBITMQ_URL=
CHECKS=
SYSTEMD_UNITS=

# Alerts: set a channel to turn them on. MONITOR_PUBLIC_URL makes messages link here.
MONITOR_PUBLIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEARTBEAT_URL=

# Email needs a sender, recipients, and at least one provider. Every provider set is
# tried in this order until one sends: SES, Resend, Postmark, Mailgun, SendGrid, SMTP.
EMAIL_FROM=
EMAIL_TO=
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_REGION=eu
# SENDGRID_API_KEY=
# SMTP_URL=smtp://user:password@smtp.example.com:587

COMPOSE_PROFILES=
SMART_INTERVAL=15m

# Optional overrides: join an existing Docker network, read systemd units, or both.
# COMPOSE_FILE=compose.yml:compose.network.yml
# COMPOSE_FILE=compose.yml:compose.systemd.yml
# APP_NETWORK=your-network

# Host paths; container mount locations retain the application's defaults.
HOST_PROC_PATH=/proc
HOST_SYS_PATH=/sys
HOST_ROOT_PATH=/
HOST_DEV_PATH=/dev
DOCKER_SOCKET_PATH=/var/run/docker.sock
HOST_DBUS_SOCKET_PATH=/run/dbus/system_bus_socket
# DOCKER_PROXY_USER=1000:1000

# Optional bind directories; otherwise Compose manages project-scoped volumes.
# MONITOR_DATA_PATH=/srv/monitor/data
# MONITOR_SMART_PATH=/srv/monitor/smart

# Set to false to hide running query and command text on service pages.
# MONITOR_QUERY_TEXT=true

# Set to false to stop the proxy serving container logs to the dashboard.
# MONITOR_CONTAINER_LOGS=true

# Override the collector endpoint, or set it empty to disable container metrics.
# MONITOR_DOCKER_HOST=http://docker-proxy:2375
