{
  "name": "@noria-monitor/dashboard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --report-unused-disable-directives --max-warnings 0 src tests *.config.ts",
    "lint:fix": "oxlint --type-aware --report-unused-disable-directives --fix --max-warnings 0 src tests *.config.ts",
    "format": "oxfmt --write \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,css}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,css}\"",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "coverage": "vitest run --coverage",
    "brand": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2004",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
