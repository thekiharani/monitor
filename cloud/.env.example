APP_ENV=development
PROBE_REGIONS=local,eu-west
LOCAL_PROBE_REGION=local
PROBE_ALLOW_PRIVATE=true
APP_ADDR=:8910
DASHBOARD_DIR=
APP_ORIGIN=http://localhost:3910
DASHBOARD_ORIGIN=http://localhost:3910
API_ORIGIN=http://localhost:8910
STATUS_ORIGIN=http://localhost:8910
CORS_ALLOWED_ORIGINS=http://localhost:3910

DATABASE_URL=postgres://monitor:monitor_local@localhost:5452/monitor_core?sslmode=disable
APP_DATABASE_URL=postgres://monitor_app:monitor_app_local@localhost:5452/monitor_core?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM_EMAIL=auth@monitor.local

OTP_TTL=10m
OTP_HMAC_KEY=
SESSION_TTL=336h
APP_ENCRYPTION_KEY=


PAYSTACK_CURRENCY=KES
PAYSTACK_STARTER_PLAN_CODE=
PAYSTACK_PRO_PLAN_CODE=
PAYSTACK_BUSINESS_PLAN_CODE=
PAYSTACK_STARTER_USD_PLAN_CODE=
PAYSTACK_PRO_USD_PLAN_CODE=
PAYSTACK_BUSINESS_USD_PLAN_CODE=
STARTER_PRICE_KES_MINOR=50000
PRO_PRICE_KES_MINOR=200000
BUSINESS_PRICE_KES_MINOR=500000
BILLING_GRACE_PERIOD=72h
PAYSTACK_SECRET_KEY=

AWS_REGION=
SES_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/monitor-cloud/development
CLOUDWATCH_LOG_STREAM={app}-{env}-{hostname}-{date}
CLOUDWATCH_LOG_CREATE_GROUP=true
CLOUDWATCH_BATCH_SIZE=25
CLOUDWATCH_BUFFER_SIZE=1000
CLOUDWATCH_FLUSH_INTERVAL=5s
CLOUDWATCH_LOG_RETENTION_DAYS=30


LOG_LEVEL=info
PPROF_ENABLED=false
# The pprof listener also serves expvar counters at /debug/vars. Keep it bound
# to loopback.
PPROF_ADDR=127.0.0.1:6060

# Comma-separated IP addresses or CIDR blocks of the reverse proxies allowed to
# set forwarding headers. Anything else and CF-Connecting-IP / X-Forwarded-For /
# X-Real-IP are ignored, because a client could otherwise forge its own address
# and rotate past the rate limiter and the OTP throttle. Parsed once at startup;
# a malformed value refuses to boot.
TRUSTED_PROXY=

# Strict-Transport-Security max-age. Emitted only when APP_ORIGIN is https, so
# a plain-HTTP development origin is never pinned to a scheme it does not serve.
HSTS_MAX_AGE=8760h
